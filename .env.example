# Copy to .env and replace every password with a unique local development secret.
POSTGRES_USER=mcp_dev
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_DB=mcp_control_plane
DATABASE_URL=postgresql://mcp_dev:replace-with-a-long-random-local-password@127.0.0.1:54329/mcp_control_plane

MONGO_INITDB_ROOT_USERNAME=mcp_root
MONGO_INITDB_ROOT_PASSWORD=replace-with-another-long-random-password

REDIS_PASSWORD=replace-with-a-third-long-random-password
