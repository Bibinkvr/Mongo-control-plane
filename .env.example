# Copy to .env and replace every password with a unique local development secret.
POSTGRES_USER=mcp_dev
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_DB=mcp_control_plane
DATABASE_URL=postgresql://mcp_dev:replace-with-a-long-random-local-password@127.0.0.1:54329/mcp_control_plane

MONGO_INITDB_ROOT_USERNAME=mcp_root
MONGO_INITDB_ROOT_PASSWORD=replace-with-another-long-random-password

REDIS_PASSWORD=replace-with-a-third-long-random-password

# Generate with: openssl rand -base64 32
# Keep previous key versions during rotation until all stored secrets are re-wrapped.
CONNECTION_ENCRYPTION_KEYS={"1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
CONNECTION_ENCRYPTION_CURRENT_VERSION=1

# Explicitly allow RFC1918/ULA MongoDB targets for trusted private networks only.
# Loopback and link-local/cloud-metadata targets remain blocked by the worker.
MONGODB_ALLOW_PRIVATE_NETWORKS=false
# Development only. Production startup rejects this setting.
MONGODB_ALLOW_LOOPBACK=false

# Backup worker remains disabled unless a separate worker network namespace has
# an enforced outbound allowlist. This value is an operator attestation only.
BACKUP_WORKER_EGRESS_ISOLATED=false
# Absolute path to the installed MongoDB Database Tools mongodump binary.
MONGODUMP_PATH=/usr/bin/mongodump
# Private persistent path; never place this under a web root.
BACKUP_STORAGE_ROOT=/var/lib/mongo-control-plane/backups
BACKUP_MAX_BYTES=21474836480
BACKUP_TIMEOUT_MS=21600000
